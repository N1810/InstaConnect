{
  "name": "@neerajkr1810/instaconnect-core",
  "version": "1.0.0",
  "description": "Core framework-agnostic Instagram Graph & Login SDK",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "dev": "tsup src/index.ts --format esm,cjs --dts --watch",
    "test": "vitest run --dir ../../tests/core",
    "test:coverage": "vitest run --coverage --dir ../../tests/core",
    "lint": "eslint \"src/**/*.ts\" --config ../../eslint.config.js",
    "typecheck": "tsc --noEmit",
    "clean": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\""
  },
  "keywords": [
    "instagram",
    "instagram-api",
    "instagram-graph-api",
    "meta",
    "oauth",
    "sdk",
    "typescript"
  ],
  "license": "MIT"
}

