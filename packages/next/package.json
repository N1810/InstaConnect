{
  "name": "@instaconnect/next",
  "version": "1.0.0",
  "description": "Next.js App Router and Pages Router integration for InstaConnect",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js",
      "require": "./dist/server/index.cjs"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js",
      "require": "./dist/client/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup src/index.ts src/server/index.ts src/client/index.ts --format esm,cjs --dts --clean --external react,react-dom,next,@instaconnect/core,@instaconnect/react",
    "dev": "tsup src/index.ts src/server/index.ts src/client/index.ts --format esm,cjs --dts --watch --external react,react-dom,next,@instaconnect/core,@instaconnect/react",
    "test": "vitest run --dir ../../tests/next",
    "test:coverage": "vitest run --coverage --dir ../../tests/next",
    "lint": "eslint \"src/**/*.{ts,tsx}\" --config ../../eslint.config.js",
    "typecheck": "tsc --noEmit",
    "clean": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\""
  },
  "dependencies": {
    "@instaconnect/core": "workspace:*",
    "@instaconnect/react": "workspace:*"
  },
  "peerDependencies": {
    "next": "^13.4.0 || ^14.0.0 || ^15.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "keywords": [
    "instagram",
    "nextjs",
    "app-router",
    "oauth",
    "route-handlers"
  ],
  "license": "MIT"
}

