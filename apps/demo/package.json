{
  "name": "@instaconnect/demo",
  "version": "1.0.0",
  "private": true,
  "description": "Next.js App Router Showcase & Demo for InstaConnect SDK",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run --dir ../../tests/demo",
    "test:coverage": "vitest run --coverage --dir ../../tests/demo",
    "lint": "eslint \"app/**/*.{ts,tsx}\" \"components/**/*.{ts,tsx}\" \"lib/**/*.{ts,tsx}\" --config ../../eslint.config.js",
    "typecheck": "tsc --noEmit",
    "clean": "node -e \"fs.rmSync('.next', { recursive: true, force: true })\""
  },
  "dependencies": {
    "@neerajkr1810/instaconnect-core": "workspace:*",
    "@neerajkr1810/instaconnect-next": "workspace:*",
    "@neerajkr1810/instaconnect-react": "workspace:*",
    "next": "^14.2.21",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2"
  }
}

